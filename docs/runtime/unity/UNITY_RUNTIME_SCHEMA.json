{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noveris.game/schemas/game-runtime-v2.json",
  "title": "NOVERIS Unity Runtime Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "runtime"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritativeEndpoint",
        "runtimeSchemaId",
        "runtimeSchemaVersion",
        "sourceRuntimeSchemaId",
        "contentVersion",
        "minimumClientVersion",
        "capabilities",
        "generatedAt",
        "checksumAlgorithm",
        "packageChecksum",
        "contractVersions",
        "compatibilityPolicy",
        "validationStatus"
      ],
      "properties": {
        "authoritativeEndpoint": { "const": "/api/export/unity-runtime.json" },
        "runtimeSchemaId": { "const": "game-runtime-v2" },
        "runtimeSchemaVersion": { "const": "2.0.0" },
        "sourceRuntimeSchemaId": { "type": "string", "minLength": 1 },
        "contentVersion": { "type": "integer", "minimum": 66 },
        "minimumClientVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "generatedAt": { "type": "string", "format": "date-time" },
        "checksumAlgorithm": { "const": "sha256" },
        "packageChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contractVersions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } },
        "compatibilityPolicy": {
          "type": "object",
          "required": ["schemaVersionPolicy", "minimumClientPolicy", "missingCapabilityPolicy", "unsupportedRequiredContractPolicy", "unknownOptionalCapabilityPolicy"],
          "properties": {
            "schemaVersionPolicy": { "const": "exact_match_required" },
            "minimumClientPolicy": { "const": "reject_below_minimum" },
            "missingCapabilityPolicy": { "const": "reject" },
            "unsupportedRequiredContractPolicy": { "const": "reject" },
            "unknownOptionalCapabilityPolicy": { "const": "ignore" }
          }
        },
        "validationStatus": { "const": "Ready" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["metadata", "progressionSystem", "actionSystem", "timeActionContract", "upgrades"],
      "properties": {
        "metadata": { "type": "object" },
        "progressionSystem": { "type": "object" },
        "actionSystem": { "type": "object" },
        "timeActionContract": { "type": "object" },
        "upgrades": { "type": "array" }
      }
    }
  }
}
